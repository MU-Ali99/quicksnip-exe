<Window x:Class="QuickSnip.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickSnip Settings"
        Width="504" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="420" MinHeight="520"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="{StaticResource QuickSnipFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="7"
                      CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="64" Height="34">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.10">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="0" Duration="0" />
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color" To="#6879B8" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="29" Duration="0" />
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color" To="#5368E8" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Track" CornerRadius="18">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#6879B8" />
                                </Border.Background>
                            </Border>
                            <Ellipse x:Name="Thumb" Width="27" Height="27" Fill="White"
                                     HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#28233D99" />
            <Setter Property="BorderBrush" Value="#5C8296E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#35203A9B" />
            <Setter Property="BorderBrush" Value="#557CB8F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="HotkeySurface" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HotkeySurface" Property="Background" Value="#55354FB8" />
                                <Setter TargetName="HotkeySurface" Property="BorderBrush" Value="#FFA0ABFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HotkeySurface" Property="BorderBrush" Value="#AA8999F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceButton" TargetType="RadioButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#DCE8FF" />
            <Setter Property="Background" Value="#35203A9B" />
            <Setter Property="BorderBrush" Value="#557CB8F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceSurface" Margin="3,0" CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="#504E8DE0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="#FF5368E8" />
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#FFA0ABFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#55FFFFFF" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="33" />
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CloseSurface" CornerRadius="0" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <ColorAnimation Storyboard.TargetName="CloseSurface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#E81123" Duration="0:0:0.14" />
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <ColorAnimation Storyboard.TargetName="CloseSurface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#002878DB" Duration="0:0:0.14" />
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" BorderBrush="#777E91E8" BorderThickness="1" ClipToBounds="True">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2874DF" Offset="0" />
                <GradientStop Color="#3D5BCB" Offset="0.43" />
                <GradientStop Color="#1B2B78" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Height="34" VerticalAlignment="Top" Panel.ZIndex="20"
                Background="#245FC7" BorderBrush="#557E91E8" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                <Image Source="Assets/QuickSnip-source.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="QuickSnip Settings" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="#EAF5FF" FontSize="12" FontWeight="SemiBold" />
                <Button Grid.Column="2" Style="{StaticResource TitleCloseButton}" Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" ToolTip="Close" />
            </Grid>
        </Border>

        <!-- Layered waves inspired by the original browser extension. -->
        <Path Fill="#263FA9" Opacity="0.38" Stretch="Fill"
              Data="M 0,95 C 135,15 290,40 504,145 L 504,330 C 290,250 145,260 0,350 Z"
              VerticalAlignment="Top" Height="350" />
        <Path Fill="#111F61" Opacity="0.48" Stretch="Fill"
              Data="M 0,0 C 140,90 300,45 504,145 L 504,290 C 310,180 135,240 0,175 Z"
              VerticalAlignment="Bottom" Height="330" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,34,0,0">
            <StackPanel Margin="24,22,14,22">
                <Grid Margin="0,0,0,20"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/QuickSnip-source.png" Width="58" Height="58" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="QuickSnip" Style="{StaticResource TypeTitle}" Foreground="White" />
                        <TextBlock Text="One click. One snip." Style="{StaticResource TypeBody}" Foreground="#E2EEFF" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource InfoButton}" Width="29" Height="29"
                            VerticalAlignment="Bottom" Margin="0,0,0,-5"
                            Click="InformationButton_Click" Content="i"
                            FontFamily="Georgia" FontSize="15" FontWeight="Bold"
                            ToolTip="How QuickSnip works" />
                </Grid>

                <Border Style="{StaticResource GlassCard}" Background="#332044A8" BorderBrush="#5547C8FF">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Hotkeys" Style="{StaticResource TypeHeading2}" Foreground="White" />
                                <TextBlock Text="Click a shortcut, then press new keys"
                                           Foreground="#DCE8FF" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" /><ColumnDefinition />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drag Snip" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox x:Name="DragSnipHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                    Tag="DragSnip" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" /><ColumnDefinition />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Screen Snip" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox x:Name="QuickSnipHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                    Tag="QuickSnip" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" /><ColumnDefinition />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Window Snip" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox x:Name="WindowSnipHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                    Tag="WindowSnip" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" /><ColumnDefinition />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lock Snip" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox x:Name="LockSnipHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                    Tag="LockSnip" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Suggested: Alt + 1  •  Alt + 2  •  Alt + 3"
                                       Foreground="#DCE8FF" FontSize="11" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Width="96" Height="32"
                                    Style="{StaticResource ActionButton}" Click="ResetHotkeysButton_Click"
                                    Content="Reset all" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Default snip mode" Style="{StaticResource TypeHeading2}" Foreground="White" />
                        <TextBlock Text="Choose what left-click captures from the taskbar"
                                   FontSize="12" Foreground="#DCE8FF" Margin="0,2,0,14" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="DragSnipToggle" GroupName="DefaultSnipMode" Content="Drag Snip"
                                         Style="{StaticResource ChoiceButton}" Checked="DefaultSnipMode_Changed" />
                            <RadioButton x:Name="QuickSnipToggle" GroupName="DefaultSnipMode" Content="Screen Snip"
                                         Style="{StaticResource ChoiceButton}" Checked="DefaultSnipMode_Changed" />
                            <RadioButton x:Name="ActiveWindowToggle" GroupName="DefaultSnipMode" Content="Window Snip"
                                         Style="{StaticResource ChoiceButton}" Checked="DefaultSnipMode_Changed" />
                        </UniformGrid>
                        <Border Height="1" Background="#44FFFFFF" Margin="0,15,0,13" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Show modes in taskbar menu" Foreground="White" FontWeight="Bold" />
                                <TextBlock Text="Display alternate snip modes when QuickSnip is right-clicked"
                                           Foreground="#DCE8FF" FontSize="12" Margin="0,2,10,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="TaskbarModesToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}"
                        Background="#44233A91" BorderBrush="#66758CEB">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Lock Snip" Style="{StaticResource TypeHeading2}" Foreground="White" />
                                <TextBlock Text="Build a scrolling screenshot section by section"
                                           FontSize="12" Foreground="#DCE8FF" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="LockSnipToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="LockSnipSetting_Changed" Unchecked="LockSnipSetting_Changed" />
                        </Grid>

                        <StackPanel x:Name="LockSnipControls" Margin="0,17,0,0">
                            <TextBlock Text="Capture target" Foreground="White" FontWeight="Bold" Margin="2,0,0,7" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="LockDisplayChoice" GroupName="LockTarget" Content="Screen Snip"
                                             Style="{StaticResource ChoiceButton}" FontWeight="Bold" VerticalAlignment="Center"
                                             Margin="-4,0,4,0"
                                             Checked="LockSnipSetting_Changed" />
                                <TextBox x:Name="LockScreenSnipHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                        Tag="LockScreenSnip" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="LockWindowChoice" GroupName="LockTarget" Content="Window Snip"
                                             Style="{StaticResource ChoiceButton}" FontWeight="Bold" VerticalAlignment="Center"
                                             Margin="-4,0,4,0"
                                             Checked="LockSnipSetting_Changed" />
                                <TextBox x:Name="LockWindowSnipHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                        Tag="LockWindowSnip" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Previous position" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="LockPreviousHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                        Tag="LockPrevious" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Next position" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="LockNextHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button Grid.Column="2" Margin="7,0,0,0" Style="{StaticResource ActionButton}"
                                        Tag="LockNext" Click="ClearHotkeyButton_Click" Content="Clear" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="Close Lock Snip" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="12" Background="#55354FB8"
                                        BorderBrush="#778899F0" BorderThickness="1" Padding="12,8">
                                    <TextBlock Text="Mouse wheel button" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Button Margin="0,13,0,0" Height="36" Style="{StaticResource ActionButton}"
                                    Click="ResetLockSnipHotkeysButton_Click" Content="Reset Lock Snip Hotkeys" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}" Background="#381D2F82" BorderBrush="#4A7186D8">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource TypeHeading2}" Foreground="White" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#2EFFFFFF" CornerRadius="14">
                                <TextBlock Text="↓" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock x:Name="SaveFileLabel" Text="Save image" FontSize="14" Foreground="#D4E2FF" />
                                <TextBlock x:Name="SaveLocationText" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <CheckBox x:Name="SavePngToggle" Grid.Column="2" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#2EFFFFFF" CornerRadius="14">
                                <TextBlock Text="▣" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="Copy to clipboard" FontSize="14" Foreground="#D4E2FF" />
                                <TextBlock Text="Ready to paste with Ctrl+V" FontSize="13" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                            <CheckBox x:Name="ClipboardToggle" Grid.Column="2" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ActionButton}" Click="ChangeFolderButton_Click" Content="Change Folder" />
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="OpenFolderButton_Click" Content="Open Folder" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Save format" Style="{StaticResource TypeHeading2}" Foreground="White" Margin="0,0,0,14" />
                        <TextBlock Text="Format" Foreground="#DCE8FF" FontWeight="Bold" Margin="3,0,0,7" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="PngFormatChoice" GroupName="Format" Content="PNG"
                                         Style="{StaticResource ChoiceButton}" Checked="SaveChoice_Changed" />
                            <RadioButton x:Name="JpegFormatChoice" GroupName="Format" Content="JPEG"
                                         Style="{StaticResource ChoiceButton}" Checked="SaveChoice_Changed" />
                            <RadioButton x:Name="WebpFormatChoice" GroupName="Format" Content="WebP"
                                         Style="{StaticResource ChoiceButton}" Checked="SaveChoice_Changed" />
                        </UniformGrid>
                        <Grid Margin="3,15,3,0">
                            <TextBlock Text="Quality" Foreground="#DCE8FF" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border x:Name="LosslessBadge" HorizontalAlignment="Right" CornerRadius="10"
                                    Background="#505368E8" BorderBrush="#808899F4" BorderThickness="1" Padding="10,3">
                                <TextBlock Text="Lossless" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <UniformGrid x:Name="QualityChoices" Columns="3" Margin="0,7,0,0">
                            <RadioButton x:Name="LowQualityChoice" GroupName="Quality" Content="Low"
                                         Style="{StaticResource ChoiceButton}" Checked="SaveChoice_Changed" />
                            <RadioButton x:Name="MediumQualityChoice" GroupName="Quality" Content="Medium"
                                         Style="{StaticResource ChoiceButton}" Checked="SaveChoice_Changed" />
                            <RadioButton x:Name="HighQualityChoice" GroupName="Quality" Content="High"
                                         Style="{StaticResource ChoiceButton}" Checked="SaveChoice_Changed" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}" Background="#381D2F82" BorderBrush="#4A7186D8">
                    <StackPanel>
                        <TextBlock Text="Feedback and recovery" Style="{StaticResource TypeHeading2}" Foreground="White" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="“Snip taken” toast" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="Local confirmation only; disabled by default" Foreground="#DCE8FF" FontSize="12" />
                            </StackPanel>
                            <CheckBox x:Name="ToastToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ActionButton}" Click="ResetWindowButton_Click" Content="Reset Window" />
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="RestoreDefaultsButton_Click" Content="Restore Defaults" />
                        </Grid>
                        <Button Margin="0,8,0,0" Style="{StaticResource ActionButton}"
                                Click="RecycleSnipsButton_Click" Content="🗑  Move Snips to Recycle Bin" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Margin="2,18,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#E2EEFF" />
                <TextBlock x:Name="VersionText" TextAlignment="Center" Margin="0,12,0,0" FontSize="11" Foreground="#BFD5FF" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
