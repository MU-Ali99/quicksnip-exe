<Window x:Class="RightSnip.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightSnip Options"
        Width="430"
        Height="535"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F8FD">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="155" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="#1269D3">
            <Ellipse Width="390" Height="145" Fill="#2244BFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-110,-68" />
            <Ellipse Width="310" Height="120" Fill="#3329A4F5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-95,0,0,-57" />

            <Button Width="34" Height="34" Margin="0,18,18,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="InformationButton_Click" Content="i" FontFamily="Georgia" FontSize="18" FontWeight="Bold"
                    Foreground="White" Background="#22FFFFFF" BorderBrush="#66FFFFFF" Cursor="Hand" ToolTip="How RightSnip works" />

            <StackPanel Margin="30,27,68,20">
                <TextBlock Text="RightSnip" FontFamily="Century Gothic, Segoe UI" FontSize="31" FontWeight="Bold" Foreground="White" />
                <TextBlock Margin="0,7,0,0" Text="Capture. Save. Paste." FontSize="16" Foreground="#DDEEFF" />
                <TextBlock x:Name="VersionText" Margin="0,8,0,0" FontSize="12" Foreground="#BFDFFF" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,24,28,26">
            <Button x:Name="RightSnipButton" Height="60" Click="RightSnipButton_Click" Content="Right Snip"
                    FontSize="17" FontWeight="SemiBold" Foreground="White" Background="#1677E8" BorderThickness="0" Cursor="Hand" />

            <Border Margin="0,18,0,0" Background="White" BorderBrush="#D6E5F5" BorderThickness="1" CornerRadius="10" Padding="17,15">
                <StackPanel>
                    <TextBlock Text="Save location" FontSize="13" Foreground="#74869A" />
                    <TextBlock x:Name="SaveLocationText" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#26384A" TextWrapping="Wrap" />
                    <Button Margin="0,13,0,0" Height="40" Click="OpenFolderButton_Click" Content="Open Snips Folder"
                            FontSize="14" FontWeight="SemiBold" Foreground="#1269D3" Background="#F7FBFF" BorderBrush="#B8D5F6" Cursor="Hand" />
                </StackPanel>
            </Border>

            <Button Margin="0,18,0,0" Height="38" Click="CloseButton_Click" Content="Close"
                    Foreground="#526274" Background="Transparent" BorderBrush="#CCD8E5" Cursor="Hand" />

            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#526274" />
        </StackPanel>
    </Grid>
</Window>
