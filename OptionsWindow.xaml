<Window x:Class="QuickSnip.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickSnip Settings"
        Width="504" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="420" MinHeight="520"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="7"
                      CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="64" Height="34">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.10">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="0" Duration="0" />
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color" To="#7893DA" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="29" Duration="0" />
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color" To="#62D7F4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Track" CornerRadius="18">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#7893DA" />
                                </Border.Background>
                            </Border>
                            <Ellipse x:Name="Thumb" Width="27" Height="27" Fill="White"
                                     HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#55FFFFFF" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="33" />
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CloseSurface" CornerRadius="0" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <ColorAnimation Storyboard.TargetName="CloseSurface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#E81123" Duration="0:0:0.14" />
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <ColorAnimation Storyboard.TargetName="CloseSurface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#002878DB" Duration="0:0:0.14" />
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" BorderBrush="#77C7F5FF" BorderThickness="1" ClipToBounds="True">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#51A7F3" Offset="0" />
                <GradientStop Color="#3868DE" Offset="0.43" />
                <GradientStop Color="#203A9B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Height="34" VerticalAlignment="Top" Panel.ZIndex="20"
                Background="#2878DB" BorderBrush="#55C7F5FF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                <Image Source="Assets/QuickSnip-source.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="QuickSnip Settings" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="#EAF5FF" FontSize="12" FontWeight="SemiBold" />
                <Button Grid.Column="2" Style="{StaticResource TitleCloseButton}" Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" ToolTip="Close" />
            </Grid>
        </Border>

        <!-- Layered waves inspired by the original browser extension. -->
        <Path Fill="#1853C7" Opacity="0.34" Stretch="Fill"
              Data="M 0,95 C 135,15 290,40 504,145 L 504,330 C 290,250 145,260 0,350 Z"
              VerticalAlignment="Top" Height="350" />
        <Path Fill="#152D87" Opacity="0.42" Stretch="Fill"
              Data="M 0,0 C 140,90 300,45 504,145 L 504,290 C 310,180 135,240 0,175 Z"
              VerticalAlignment="Bottom" Height="330" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,34,0,0">
            <StackPanel Margin="24,22,24,22">
                <Grid Margin="0,0,0,20"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/QuickSnip-source.png" Width="58" Height="58" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="QuickSnip" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="One click. One snip." FontSize="14" Foreground="#E2EEFF" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource InfoButton}" VerticalAlignment="Top"
                            Click="InformationButton_Click" Content="i"
                            FontFamily="Georgia" FontSize="18" FontWeight="Bold"
                            ToolTip="How QuickSnip works" />
                </Grid>

                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Choose your snip mode" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="QuickSnip" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="Capture the display under your pointer" FontSize="13" Foreground="#DCE8FF" />
                            </StackPanel>
                            <CheckBox x:Name="QuickSnipToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Border Height="1" Background="#44FFFFFF" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Window Snip" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="Capture the currently focused application" FontSize="13" Foreground="#DCE8FF" />
                            </StackPanel>
                            <CheckBox x:Name="ActiveWindowToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Border Height="1" Background="#44FFFFFF" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Drag Snip" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="Drag to capture a selected area" FontSize="13" Foreground="#DCE8FF" />
                            </StackPanel>
                            <CheckBox x:Name="DragSnipToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Style="{StaticResource GlassCard}" Background="#332044A8" BorderBrush="#3347A6FF">
                    <StackPanel>
                        <TextBlock Text="Output" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#2EFFFFFF" CornerRadius="10">
                                <TextBlock Text="↓" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="Save PNG" FontSize="14" Foreground="#D4E2FF" />
                                <TextBlock x:Name="SaveLocationText" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <CheckBox x:Name="SavePngToggle" Grid.Column="2" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#2EFFFFFF" CornerRadius="10">
                                <TextBlock Text="▣" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="Copy to clipboard" FontSize="14" Foreground="#D4E2FF" />
                                <TextBlock Text="Ready to paste with Ctrl+V" FontSize="13" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                            <CheckBox x:Name="ClipboardToggle" Grid.Column="2" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                        </Grid>
                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ActionButton}" Click="ChangeFolderButton_Click" Content="Change Folder" />
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="OpenFolderButton_Click" Content="Open Folder" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" />
                        <ColumnDefinition /><ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="QuickSnipButton" Style="{StaticResource ActionButton}" Height="46"
                            Click="QuickSnipButton_Click" Content="QuickSnip" Background="#42BDEB" BorderThickness="0" />
                    <Button x:Name="ActiveWindowButton" Grid.Column="2" Style="{StaticResource ActionButton}" Height="46"
                            Click="ActiveWindowButton_Click" Content="Window Snip" Background="#506CC8" />
                    <Button x:Name="DragSnipButton" Grid.Column="4" Style="{StaticResource ActionButton}" Height="46"
                            Click="DragSnipButton_Click" Content="Drag Snip" Background="#506CC8" />
                </Grid>

                <TextBlock x:Name="StatusText" Margin="2,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#E2EEFF" />
                <TextBlock x:Name="VersionText" TextAlignment="Center" Margin="0,12,0,0" FontSize="11" Foreground="#BFD5FF" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
