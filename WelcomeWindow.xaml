<Window x:Class="QuickSnip.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickSnip Information"
        Width="504" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="420" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="7"
                      CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,15" />
        </Style>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Circle" CornerRadius="18" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Circle" Property="Background" Value="#55FFFFFF" />
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48" /><Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#42BDEB" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background" Value="#65D5F3" />
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="33" />
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CloseSurface" CornerRadius="0" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <ColorAnimation Storyboard.TargetName="CloseSurface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#E81123" Duration="0:0:0.14" />
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <ColorAnimation Storyboard.TargetName="CloseSurface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#002878DB" Duration="0:0:0.14" />
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" BorderBrush="#77C7F5FF" BorderThickness="1" ClipToBounds="True">
        <Grid ClipToBounds="True">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#51A7F3" Offset="0" /><GradientStop Color="#3868DE" Offset="0.45" />
                <GradientStop Color="#203A9B" Offset="1" />
            </LinearGradientBrush></Grid.Background>
            <Border Height="34" VerticalAlignment="Top" Panel.ZIndex="20"
                    Background="#2878DB" BorderBrush="#55C7F5FF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <Image Source="Assets/QuickSnip-source.png" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="QuickSnip Information" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="#EAF5FF" FontSize="12" FontWeight="SemiBold" />
                    <Button Grid.Column="2" Style="{StaticResource TitleCloseButton}" Content="×"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" ToolTip="Close" />
                </Grid>
            </Border>
            <Path Fill="#1853C7" Opacity="0.34" Stretch="Fill"
                  Data="M 0,95 C 135,15 290,40 504,145 L 504,330 C 290,250 145,260 0,350 Z"
                  VerticalAlignment="Top" Height="350" />
            <Path Fill="#152D87" Opacity="0.42" Stretch="Fill"
                  Data="M 0,0 C 140,90 300,45 504,145 L 504,290 C 310,180 135,240 0,175 Z"
                  VerticalAlignment="Bottom" Height="290" />

            <ScrollViewer Margin="0,34,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,18,26,24">
                <Grid Margin="0,0,0,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Image Source="Assets/QuickSnip-source.png" Width="60" Height="60" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QuickSnip" FontSize="29" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="WelcomeSubtitle" Text="How QuickSnip works"
                                   Margin="0,3,0,0" FontSize="15" Foreground="#E2EEFF" />
                    </StackPanel>
                </Grid>

                <Border Background="#332044A8" BorderBrush="#55A9DCFF" BorderThickness="1"
                        CornerRadius="18" Padding="18,15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#42BDEB" CornerRadius="20" VerticalAlignment="Top">
                            <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Pin QuickSnip to your taskbar" FontSize="16" FontWeight="Bold" Foreground="White" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="#DCE8FF"
                                       Text="Pin QuickSnip from the Start menu to use it the intended—and most efficient—way." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Left-click the taskbar icon" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="#DCE8FF"
                                   Text="Takes the snip mode of your choice—QuickSnip by default—and is ready to paste." />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Right-click the taskbar icon" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13" Foreground="#DCE8FF"
                                   Text="View alternate snip modes, QuickSnip Settings, or your saved snips folder." />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="UnderstandCheckBox" Margin="4,18,0,0"
                          Content="I understand how QuickSnip works"
                          FontSize="14" Foreground="White"
                          Checked="UnderstandCheckBox_Changed"
                          Unchecked="UnderstandCheckBox_Changed" />

                <Button x:Name="ContinueButton" Margin="0,18,0,0" Style="{StaticResource PrimaryButton}"
                        Click="ContinueButton_Click" Content="Continue to QuickSnip Settings" IsEnabled="False" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
