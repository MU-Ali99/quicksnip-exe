<Window x:Class="QuickSnip.LockTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#5507132A"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Cursor="Cross" PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Canvas>
        <Border x:Name="Hint" CornerRadius="9" Padding="12,7" BorderThickness="0"
                Canvas.Left="24" Canvas.Top="24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F02278E8" Offset="0" />
                    <GradientStop Color="#F03D62D8" Offset="0.55" />
                    <GradientStop Color="#F023399F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/QuickSnip-source.png" Width="20" Height="20" Margin="0,0,7,0" />
                <TextBlock Text="Click the display or window to lock  •  Esc to cancel"
                           Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
