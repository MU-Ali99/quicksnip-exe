<Window x:Class="QuickSnip.CaptureToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="185" Height="52" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" IsHitTestVisible="False" Opacity="0">
    <Border CornerRadius="11" Padding="7">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F02278E8" Offset="0" />
                <GradientStop Color="#F03D62D8" Offset="0.55" />
                <GradientStop Color="#F023399F" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#142B72" BlurRadius="12" ShadowDepth="3" Opacity="0.38" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/QuickSnip-source.png" Width="31" Height="31"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                <TextBlock x:Name="TitleText" Text="Snip taken" Foreground="White"
                           FontWeight="Bold" FontSize="12" />
                <TextBlock x:Name="DetailText" Foreground="#E0EAFF" FontSize="9"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
