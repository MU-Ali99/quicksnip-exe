<Window x:Class="QuickSnip.LockSnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lock Snip" Width="300" Height="181" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <Window.FontFamily>
        <StaticResource ResourceKey="QuickSnipFont" />
    </Window.FontFamily>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#554F63C5" />
            <Setter Property="BorderBrush" Value="#8899A8F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#776F82E2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="0,19,0,8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E74856" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#B83242" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Border CornerRadius="20" BorderThickness="1" BorderBrush="#887E91EE" Padding="14,10,14,10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#622278E8" Offset="0" />
                <GradientStop Color="#623D62D8" Offset="0.5" />
                <GradientStop Color="#621B2E86" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel Opacity="0.70">
            <Grid Height="58" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Image Source="Assets/QuickSnip-source.png" Width="27" Height="27" />
                <TextBlock Grid.Column="1" Text="Lock Snip" Foreground="White"
                           Style="{StaticResource TypeHeading2}" VerticalAlignment="Center" />
                <TextBlock x:Name="TargetNameText" Grid.Row="1" Grid.ColumnSpan="2" Text="Choose a target"
                           Foreground="#E5EEFF" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
            </Grid>
            <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Height="35" Click="PreviousButton_Click">
                    <StackPanel><TextBlock Text="◀  Previous" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PreviousHotkeyText" FontSize="10" Foreground="#DCE8FF" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Height="35" Click="NextButton_Click">
                    <StackPanel><TextBlock Text="Next  ▶" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NextHotkeyText" FontSize="10" Foreground="#DCE8FF" HorizontalAlignment="Center" /></StackPanel>
                </Button>
            </Grid>
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Height="35" Click="CaptureButton_Click">
                    <StackPanel><TextBlock Text="Capture" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CaptureHotkeyText" FontSize="10" Foreground="#DCE8FF" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Height="35" Content="Reset Window" FontWeight="Bold"
                        Click="ResetWindowButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
            Style="{StaticResource WindowCloseButton}" Content="×" Opacity="0.70"
            Click="CloseButton_Click" ToolTip="Close Lock Snip • Middle click" />
    </Grid>
</Window>
